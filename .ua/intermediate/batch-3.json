      "id": "file:src/audio/context.ts",
      "type": "file",
      "name": "context.ts",
      "filePath": "src/audio/context.ts",
      "summary": "Owns the browser AudioContext lifecycle and the master gain/limiter bus, started lazily and only on an explicit user gesture via ensureAudio().",
      "tags": ["audio", "singleton", "lifecycle", "browser-only"],
      "complexity": "simple",
      "languageNotes": "Gesture-gated Tone.start() is required by browsers before any Web Audio node may sound."
    },
    {
      "id": "file:src/audio/perform.ts",
      "type": "file",
      "name": "perform.ts",
      "filePath": "src/audio/perform.ts",
