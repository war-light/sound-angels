      "tags": ["audio", "audition", "input", "browser-only"],
      "complexity": "simple"
    },
    {
      "id": "file:src/audio/player.ts",
      "type": "file",
      "name": "player.ts",
      "filePath": "src/audio/player.ts",
      "summary": "Tone.Transport bridge that schedules 16th-note steps from engine arrangement snapshots and renders drums, bass, melody lanes, and chord stabs without ever writing combat state.",
      "tags": ["audio", "scheduler", "audio-renderer", "transport"],
      "complexity": "moderate",
      "languageNotes": "Audio events fire inside the scheduled callback for sample accuracy while UI/combat updates are deferred through Tone.getDraw() to stay on the animation frame."
    },
